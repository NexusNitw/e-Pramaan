# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.aicte-epranam.mongodb.net/epranam_db?retryWrites=true&w=majority

# Secret Keys
JWT_SECRET=aicte_epranam_super_secure_jwt_secret_key_2026

# Microservice Endpoints (Set PYTHON_SERVICES_URL for unified single-service deployment)
PYTHON_SERVICES_URL=http://localhost:8000
# Or override individually:
FORENSICS_SERVICE_URL=http://localhost:8000
OCR_SERVICE_URL=http://localhost:8000
VERIFICATION_SERVICE_URL=http://localhost:8000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

